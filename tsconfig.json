{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "strict": true
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "data/**/*.json"
  ]
}
